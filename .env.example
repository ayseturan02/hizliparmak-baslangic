# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/hizliparmak?schema=public"
# Use a long random secret (at least 32 characters)
AUTH_SECRET="replace-this-with-a-long-random-secret-before-running"
# Public base URL for links and callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Payment integration is intentionally not enabled until a provider account is configured
PAYMENT_PROVIDER="none"

# Google AdSense: use a real responsive display ad unit ID (not an example value).
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-6823236945712938"
NEXT_PUBLIC_ADSENSE_SLOT=""
# Optional separate ad unit IDs per placement; otherwise the common slot is used.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDE=""
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=""
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=""

# Required for login and registration rate limits
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Keep false until live payment verification and business setup are complete
PAYMENTS_ENABLED="false"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_SANDBOX="true"

# Optional email delivery. Enable only with a verified sender.
RESEND_API_KEY=""
EMAIL_FROM=""
SUPPORT_EMAIL=""
BUSINESS_NAME=""
BUSINESS_ADDRESS=""

# Optional server error notifications; never a public environment variable.
ALERT_EMAIL=""

# Gmail option: use a Google App Password, never the normal account password.
# EMAIL_PROVIDER may be gmail or resend. Missing credentials keep delivery disabled.
EMAIL_PROVIDER="gmail"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
